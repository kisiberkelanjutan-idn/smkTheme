# Block execution of any server-side script inside CSS styles directory
<FilesMatch "\.(?i:php|php[0-9]*|phtml|phar|inc|tpl|po|pl|py|cgi|sh|bash|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
