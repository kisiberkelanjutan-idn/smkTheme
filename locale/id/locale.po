msgid "plugins.themes.smkTheme.name"
msgstr "SMK Child Theme (Kisi Berkelanjutan)"

msgid "plugins.themes.smkTheme.description"
msgstr "Child theme OJS 3.5 turunan Default Theme yang aman, dengan opsi Hero terintegrasi, JATS XML viewer, badge SDG, dan statistik COUNTER R5 nyata."

msgid "plugins.themes.smkTheme.option.activationToken.label"
msgstr "Token Kunci Aktivasi Tema (Wajib)"

msgid "plugins.themes.smkTheme.option.activationToken.description"
msgstr "Masukkan Token Kunci Aktivasi resmi Kisi Berkelanjutan untuk mengaktifkan desain kustom, penampil interaktif, dan metrik statistik tema."

msgid "plugins.themes.smkTheme.locked.title"
msgstr "Aktivasi Tema Diperlukan"

msgid "plugins.themes.smkTheme.locked.message"
msgstr "SMK Child Theme saat ini terkunci. Silakan masukkan Token Kunci Aktivasi yang valid melalui menu Pengaturan Situs Web > Tampilan > Tema."

msgid "plugins.themes.smkTheme.option.heroScopeText.label"
msgstr "Teks Scope / Tagline Hero"

msgid "plugins.themes.smkTheme.option.heroScopeText.description"
msgstr "Ringkasan fokus dan ruang lingkup jurnal yang tampil di bawah judul pada hero beranda."

msgid "plugins.themes.smkTheme.option.heroPrimaryCtaLabel.label"
msgstr "Label Tombol Utama Hero"

msgid "plugins.themes.smkTheme.option.heroSecondaryCtaLabel.label"
msgstr "Label Tautan Sekunder Hero"

msgid "plugins.themes.smkTheme.option.heroAcceptanceRate.label"
msgstr "Metrik Acceptance Rate"

msgid "plugins.themes.smkTheme.option.heroAcceptanceRate.description"
msgstr "Kosongkan jika tidak ingin menampilkan item ini di hero beranda."

msgid "plugins.themes.smkTheme.option.heroFirstDecisionDays.label"
msgstr "Hari Keputusan Pertama (Days to 1st Decision)"

msgid "plugins.themes.smkTheme.option.heroFirstDecisionDays.description"
msgstr "Angka hari rata-rata keputusan pertama (kosongkan untuk menyembunyikan)."

msgid "plugins.themes.smkTheme.option.heroAcceptDays.label"
msgstr "Hari hingga Diterima (Days to Accept)"

msgid "plugins.themes.smkTheme.option.heroAcceptDays.description"
msgstr "Angka hari rata-rata hingga diterima (kosongkan untuk menyembunyikan)."

msgid "plugins.themes.smkTheme.option.heroShowStatsBar.label"
msgstr "Bar Statistik OJS di Beranda"

msgid "plugins.themes.smkTheme.option.heroShowStatsBar.option"
msgstr "Tampilkan bar metrik OJS 3 kolom (peneliti, pembaca/unduhan artikel, artikel SDG) pada section hero"

msgid "plugins.themes.smkTheme.option.statsLaunchLabel.label"
msgstr "Periode Awal Tracking Statistik"

msgid "plugins.themes.smkTheme.option.statsLaunchLabel.description"
msgstr "Label awal periode pencatatan pada halaman statistik jurnal (misal: January 2024)."
