# Enforce LF line endings across Windows, GitHub Actions (Linux), and cPanel so SHA256SUMS match byte-for-byte
* text=auto eol=lf
*.php text eol=lf
*.tpl text eol=lf
*.js text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.xml text eol=lf
*.po text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
.htaccess text eol=lf
*.htaccess text eol=lf
SHA256SUMS text eol=lf
